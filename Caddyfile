# {$APP_DOMAIN} sẽ được lấy từ biến môi trường.
# Local: :80
# VPS: example.com (tự động HTTPS)
{$APP_DOMAIN} {
  encode gzip zstd

  # Backend API – proxy /api thẳng tới etechs-middleware (không qua social-be)
  @api path /api*
  handle @api {
    reverse_proxy etechs-middleware:8001 {
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
      header_up Authorization {http.request.header.Authorization}
      header_up X-Tenant-Slug {http.request.header.X-Tenant-Slug}
    }
  }

  # WebSocket (Channels) – proxy /ws tới etechs-middleware
  @ws path /ws*
  handle @ws {
    reverse_proxy etechs-middleware:8001 {
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
      header_up Host {host}
    }
  }

  # Health check – etechs-middleware (Django /health/)
  handle /health {
    reverse_proxy etechs-middleware:8001
  }

  # SPA static site
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
