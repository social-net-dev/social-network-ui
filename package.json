{
  "name": "social-network-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:spec": "tsp compile ./contract",
    "gen:spec:watch": "tsp compile ./contract --watch",
    "gen:clean": "tsx scripts/transform-openapi.ts",
    "gen:hooks": "orval --config orval.config.ts",
    "gen": "pnpm gen:spec && pnpm gen:clean && pnpm gen:hooks",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "mock:seed": "tsx mock/seed.ts",
    "mock:server": "tsx mock/server.ts",
    "mock:dev": "concurrently \"pnpm mock:server\" \"vite --mode mock\"",
    "mock:start": "pnpm mock:seed && pnpm mock:server",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.3",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@scalar/hono-api-reference": "^0.9.44",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.19",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.12.2",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^4",
    "react-router-dom": "^7.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.25.0",
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.2.0",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@types/cors": "^2.8.19",
    "@types/json-server": "^0.14.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@typespec/compiler": "latest",
    "@typespec/http": "latest",
    "@typespec/openapi": "latest",
    "@typespec/openapi3": "latest",
    "@typespec/rest": "latest",
    "@typespec/versioning": "latest",
    "@vitejs/plugin-react": "^5.1.1",
    "agentation": "^1.3.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "json-server": "^0.17.4",
    "orval": "^8.5.2",
    "prettier": "^3.8.1",
    "shadcn": "^3.7.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wrangler": "^4.65.0"
  }
}
