meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{api_base}}/auth/register/
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com",
    "password": "Test@123",
    "display_name": "Test User",
    "gender": "MALE",
    "role": "STUDENT"
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.body.data;
    bru.setEnvVar("user_id", data.user_id);
  }
}
