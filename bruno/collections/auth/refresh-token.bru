meta {
  name: Refresh Token
  type: http
  seq: 5
}

post {
  url: {{api_base}}/auth/refresh/
  body: json
  auth: none
}

body:json {
  {
    "refresh": "{{refresh_token}}"
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.body;
    bru.setEnvVar("auth_token", data.access);
  }
}
