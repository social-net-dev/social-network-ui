# API Configuration – etechs-middleware (dev: port 8000, path /api)
VITE_API_BASE_URL=http://localhost:8000/api

# Message Service (be_message) – runs on port 8002 via docker-compose
VITE_API_URL_MESSAGE=http://localhost:8002
VITE_WS_URL=ws://localhost:8002/ws

# App Configuration
VITE_APP_NAME="ETECHS Social"
VITE_APP_DESCRIPTION="Mạng xã hội công nghệ ETECHS"

# Other Settings
VITE_ENABLE_MOCK_API=false
MODE=development